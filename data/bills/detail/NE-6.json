{"jurisdiction":"NE","generatedAt":"2026-11-05T05:54:04Z","bills":{"NE-2025-LR472":{"id":"NE-2025-LR472","passed":false,"number":"LR 472","title":"Interim study to examine federally funded Head Start Preschool and Early Head Start programs and to provide state policy recommendations in support of such programs","summary":null,"summarySource":null,"introduced":"2026-03-25","sponsor":{"name":"Clouse","party":"Nonpartisan","state":"NE","district":"37"},"cosponsors":[],"cosponsorCount":0,"committees":[],"actions":[{"date":"2026-08-28","text":"Notice of hearing for October 28, 2026","chamber":"Legislature"},{"date":"2026-03-30","text":"Referred to Education Committee","chamber":"Legislature"},{"date":"2026-03-25","text":"Referred to Executive Board","chamber":"Legislature"},{"date":"2026-03-25","text":"Date of introduction","chamber":"Legislature"}],"law":null,"policyArea":null,"url":"https://nebraskalegislature.gov/bills/search_by_date.php?SessionDay=2026","textUrl":"https://nebraskalegislature.gov/FloorDocs/109/PDF/Intro/LR472.pdf","versions":[{"label":"Introduced","date":null,"url":"https://nebraskalegislature.gov/FloorDocs/109/PDF/Intro/LR472.pdf","type":"PDF"}],"votes":[],"documents":[],"dataAsOf":"2026-11-01","aiSummary":"The resolution would direct the Education Committee to study federally funded Head Start Preschool and Early Head Start programs in Nebraska. The study would look at their services, funding, staffing, background check rules, and how other states support them. The committee would then report its findings and policy recommendations to the Legislature or Legislative Council.","aiSummaryBasis":"bill text","aiSummaryModel":"gpt-5.4-mini","aiSummaryGenerated":"2026-11-05","aiSummaryThin":false},"NE-2025-LR444":{"id":"NE-2025-LR444","passed":false,"number":"LR 444","title":"Interim study to examine cost models and payment models for determining behavioral health service rates in Nebraska","summary":null,"summarySource":null,"introduced":"2026-03-24","spo