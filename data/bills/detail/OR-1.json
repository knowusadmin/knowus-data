aryGenerated":"2026-11-05","aiSummaryThin":false},"OR-2026R1-HB4115":{"id":"OR-2026R1-HB4115","passed":true,"number":"HB 4115","title":"Relating to health care providers; and prescribing an effective date.","summary":"Provides that a criminal records check on certain caregivers shall last for three years, subject to exceptions. Requires certain valid criminal records checks to be portable to other care settings. Requires the authority to publish information about when a credentialed behavioral health provider must undergo a new background check. Requires a coordinated care organization to reimburse a contracted behavioral health provider retroactively to the date the provider submitted a successful application for enrollment in the state medical assistance program. Prohibits a coordinated care organization from requiring a credentialed behavioral health provider to submit a new credentialing application when the provider changes employer. Takes effect on the 91st day following adjournment sine die.","summarySource":"Oregon legislature, summary (via Open States)","introduced":"2026-02-02","sponsor":{"name":"Nancy Nathanson","party":"D","state":"OR","district":"13"},"cosponsors":[{"name":"Anna Scharf","party":"R","state":"OR","date":null,"withdrawn":false,"role":"Primary sponsor"},{"name":"Hai Pham","party":"D","state":"OR","date":null,"withdrawn":false,"role":"Primary sponsor"},{"name":"Mark Gamba","party":"D","state":"OR","date":null,"withdrawn":false},{"name":"Cyrus Javadi","party":"D","state":"OR","date":null,"withdrawn":false},{"name":"Jules Walters","party":"D","state":"OR","date":null,"withdrawn":false},{"name":"Lamar Wise","party":"D","state":"OR","date":null,"withdrawn":false},{"name":"Sara Gelser Blouin","party":"D","state":"OR","date":null,"withdrawn":false},{"name":"Tom Andersen","party":"D","state":"OR","date":null,"withdrawn":false},{"name":"Sue Rieke Smith","party":"D","state":"OR","date":null,"withdrawn":false},{"name":"Darin Harbick","party":"R","stat