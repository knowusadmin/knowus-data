","aiSummaryThin":false},"NE-2025-LB522":{"id":"NE-2025-LB522","passed":false,"number":"LB 522","title":"Change provisions relating to the date when compensation begins and provide for cost-of-living adjustments under the Nebraska Workers’ Compensation Act","summary":null,"summarySource":null,"introduced":"2025-01-21","sponsor":{"name":"Guereca","party":"Nonpartisan","state":"NE","district":"7"},"cosponsors":[],"cosponsorCount":0,"committees":[],"actions":[{"date":"2026-04-17","text":"Indefinitely postponed","chamber":"Legislature"},{"date":"2026-01-07","text":"Title printed. Carryover bill","chamber":"Legislature"},{"date":"2025-02-24","text":"Notice of hearing for March 10, 2025","chamber":"Legislature"},{"date":"2025-01-23","text":"Referred to Business and Labor Committee","chamber":"Legislature"},{"date":"2025-01-21","text":"Date of introduction","chamber":"Legislature"}],"law":null,"policyArea":null,"url":"https://nebraskalegislature.gov/bills/search_by_date.php?SessionDay=2025","textUrl":"https://nebraskalegislature.gov/FloorDocs/109/PDF/Intro/LB522.pdf","versions":[{"label":"Introduced","date":null,"url":"https://nebraskalegislature.gov/FloorDocs/109/PDF/Intro/LB522.pdf","type":"PDF"}],"votes":[],"documents":[{"label":"Fiscal Note","date":null,"url":"https://nebraskalegislature.gov/bills/view_fiscal.php?DocumentID=59623","type":"PDF"},{"label":"Statement of Intent","date":null,"url":"https://nebraskalegislature.gov/FloorDocs/109/PDF/SI/LB522.pdf","type":"PDF"}],"dataAsOf":"2026-11-01","aiSummary":"The bill would change when Nebraska workers’ compensation payments start. It would also add yearly cost-of-living adjustments, which are automatic changes to keep benefits in line with rising prices, for weekly income benefits that last more than 12 months. The new adjustment process would begin in 2026 and would affect injured workers receiving these benefits.","aiSummaryBasis":"bill text","aiSummaryModel":"gpt-5.4-mini","aiSummaryGenerated":"2026-11-05","aiSummary