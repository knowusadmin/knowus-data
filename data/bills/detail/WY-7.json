069JC001.pdf","type":"PDF"},{"label":"Amendment HB0069HW002 (Committee of the Whole) - Representative Larsen, L (Adop…","date":null,"url":"https://wyoleg.gov/2026/Amends/HB0069HW002.pdf","type":"PDF"},{"label":"Amendment HB0069HW001 (Committee of the Whole) - Representative Johnson (Withdr…","date":null,"url":"https://wyoleg.gov/2026/Amends/HB0069HW001.pdf","type":"PDF"},{"label":"Enrolled","date":null,"url":"https://wyoleg.gov/2026/Enroll/HB0069.pdf","type":"PDF"},{"label":"Introduced","date":null,"url":"https://wyoleg.gov/2026/Introduced/HB0069.pdf","type":"PDF"}],"votes":[{"date":"2026-03-06","motion":"HB0069JC001: H Adopted HB0069JC001: 50-9-2-1-0","result":"pass","chamber":"House","counts":{"yes":50,"no":9,"absent":1,"excused":2}},{"date":"2026-03-06","motion":"HB0069JC001: S Adopted HB0069JC001: 27-2-2-0-0","result":"pass","chamber":"Senate","counts":{"yes":27,"no":2,"excused":2}},{"date":"2026-03-05","motion":"H Concur:Failed 20-39-3-0-0","result":"fail","chamber":"House","counts":{"yes":20,"no":39,"excused":3}},{"date":"2026-03-03","motion":"S 3rd Reading:Passed 20-10-1-0-0","result":"pass","chamber":"Senate","counts":{"yes":20,"no":10,"excused":1}},{"date":"2026-02-26","motion":"S05 - Agriculture:Recommend Do Pass 4-0-1-0-0","result":"pass","chamber":"Senate","counts":{"yes":4,"no":0,"excused":1}},{"date":"2026-02-22","motion":"H 3rd Reading:Passed 34-27-1-0-0","result":"pass","chamber":"House","counts":{"yes":34,"no":27,"excused":1}},{"date":"2026-02-13","motion":"H08 - Transportation:Recommend Do Pass 8-0-1-0-0","result":"pass","chamber":"House","counts":{"yes":8,"no":0,"excused":1}},{"date":"2026-02-10","motion":"H Introduced and Referred to H08 - Transportation 54-8-0-0-0","result":"pass","chamber":"House","counts":{"yes":54,"no":8}}],"documents":[{"label":"Bill Digest","date":null,"url":"https://wyoleg.gov/2026/Digest/HB0069.pdf","type":"PDF"},{"label":"Fiscal Note","date":null,"url":"https://wyoleg.gov/2026/Fiscal/HB0069.pdf","type":"PDF"}],"dataAsOf":"2026-11-01","aiSummary":"The law requires the Department of Health to transfer one state land parcel in Fremont County to the Wyoming Department of Transportation, with the transportation department paying closing and title insurance costs. It also requires the department to transfer another state land parcel, and that land must be used only for homes. The department must work with the city of Lander, the Board of Land Commissioners, and the Office of State Lands and Investments, and the transportation department must report back after the transfers are finished.","aiSummaryBasis":"official summary","aiSummaryModel":"gpt-5.4-mini","aiSummaryGenerated":"2026-11-05","aiSummaryThin":false},"WY-2026-SF45":{"id":"WY-2026-SF45","passed":true,"number":"SF 45","title":"Local approval for simulcasting.","summary":"Under existing law, the Wyoming Gaming Commission issues permits for simulcasting of pari-mutuel wagering, which includes historic horse racing terminals, subject only to approval by the board of county commissioners. This act requires approval by the city, town or county where the simulcasting facility will be located before issuance or renewal of a simulcasting permit, and authorizes review and objection by overlapping local governments. This act establishes application requirements for simulcasting permits and requires public notice and a hearing before a local approving authority may approve or deny an application. This act authorizes local governments to impose reasonable conditions on approval and provides requirements for denial, renewal and revocation of approval. This act authorizes appeals of permit denials or revocations to a district court under specified conditions. This act provides that existing simulcasting permit holders may continue operations through December 31, 2027, after which they are subject to the requirements of this act.","summarySource":"Wyoming legislature, summary (via Open States)","introduced":"2026-01-14","sponsor":{"name":"Management Council","party":null,"state":"WY","district":null},"cosponsors":[],"cosponsorCount":0,"committees":[],"actions":[{"date":"2026-03-06","text":"Assigned Chapter Number 72","chamber":"Governor"},{"date":"2026-03-06","text":"Governor Signed SEA No. 0051","chamber":null},{"date":"2026-03-06","text":"H Speaker Signed SEA No. 0051","chamber":"House"},{"date":"2026-03-05","text":"S President Signed SEA No. 0051","chamber":"Senate"},{"date":"2026-03-05","text":"Assigned Number SEA No. 0051","chamber":"Governor"},{"date":"2026-03-04","text":"H Appointed JCC01 Members","chamber":"House"},{"date":"2026-03-03","text":"S Appointed JCC01 Members","chamber":"Senate"},{"date":"2026-03-03","text":"S Concur:Failed 0-30-1-0-0","chamber":"Senate"},{"date":"2026-02-26","text":"S Received for Concurrence","chamber":"Senate"},{"date":"2026-02-26","text":"H 3rd Reading:Passed 57-3-2-0-0","chamber":"House"},{"date":"2026-02-25","text":"H 2nd Reading:Passed","chamber":"House"},{"date":"2026-02-24","text":"H COW:Passed","chamber":"House"},{"date":"2026-02-20","text":"H Placed on General File","chamber":"House"},{"date":"2026-02-20","text":"H09 - Minerals:Recommend Do Pass 9-0-0-0-0","chamber":"House"},{"date":"2026-02-19","text":"H Introduced and Referred to H09 - Minerals","chamber":"House"},{"date":"2026-02-18","text":"H Received for Introduction","chamber":"House"},{"date":"2026-02-18","text":"S 3rd Reading:Passed 28-2-1-0-0","chamber":"Senate"},{"date":"2026-02-17","text":"S 2nd Reading:Passed","chamber":"Senate"},{"date":"2026-02-16","text":"S COW:Passed","chamber":"Senate"},{"date":"2026-02-13","text":"S Placed on General File","chamber":"Senate"},{"date":"2026-02-13","text":"S01 - Judiciary:Recommend Amend and Do Pass 5-0-0-0-0","chamber":"Senate"},{"date":"2026-02-09","text":"S Introduced and Referred to S01 - Judiciary 28-3-0-0-0","chamber":"Senate"},{"date":"2026-01-14","text":"S Received for Introduction","chamber":"Senate"},{"date":"2026-01-14","text":"Bill Number Assigned",