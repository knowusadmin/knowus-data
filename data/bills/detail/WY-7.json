tion":"S 3rd Reading:Passed 31-0-0-0-0","result":"pass","chamber":"Senate","counts":{"yes":31,"no":0}},{"date":"2026-02-24","motion":"S01 - Judiciary:Recommend Do Pass 4-0-1-0-0","result":"pass","chamber":"Senate","counts":{"yes":4,"no":0,"excused":1}},{"date":"2026-02-14","motion":"H 3rd Reading:Passed 61-0-1-0-0","result":"pass","chamber":"House","counts":{"yes":61,"no":0,"excused":1}},{"date":"2026-02-11","motion":"H01 - Judiciary:Recommend Do Pass 8-0-1-0-0","result":"pass","chamber":"House","counts":{"yes":8,"no":0,"excused":1}},{"date":"2026-02-09","motion":"H Introduced and Referred to H01 - Judiciary 62-0-0-0-0","result":"pass","chamber":"House","counts":{"yes":62,"no":0}}],"documents":[{"label":"Bill Digest","date":null,"url":"https://wyoleg.gov/2026/Digest/HB0008.pdf","type":"PDF"},{"label":"Fiscal Note","date":null,"url":"https://wyoleg.gov/2026/Fiscal/HB0008.pdf","type":"PDF"}],"dataAsOf":"2026-11-01","aiSummary":"Wyoming made stalking a minor a felony when the person doing it is at least 18 years old. That offense can bring up to 10 years in prison. The bill was signed into law.","aiSummaryBasis":"official summary","aiSummaryModel":"gpt-5.4-mini","aiSummaryGenerated":"2026-11-05","aiSummaryThin":false},"WY-2026-HB75":{"id":"WY-2026-HB75","passed":true,"number":"HB 75","title":"Virtual currency kiosks.","summary":"This act prohibits any person from owning, operating, or managing a virtual currency kiosk in Wyoming unless the person has been issued a license under the Wyoming Money Transmitters Act or is a financial institution and has been granted a charter under Title 13 of the Wyoming Statutes. This act creates a felony offense for operating a virtual currency kiosk without proper authorization, punishable by imprisonment for not less than three (3) years, a fine of not less than ten thousand dollars ($10,000.00), or both. This act requires the Wyoming State Banking Commissioner to promulgate rules regulating the operation of virtual currency kiosks by authorized persons.","summarySource":"Wyoming legislature, summary (via Open States)","introduced":"2026-01-31","sponsor":{"name":"Clouston","party":"R","state":"WY","district":"32"},"cosponsors":[{"name":"Brown, L","party":"R","state":"WY","date":null,"withdrawn":false},{"name":"Byron","party":"R","state":"WY","date":null,"withdrawn":false},{"name":"Connolly","party":"R","state":"WY","date":null,"withdrawn":false},{"name":"Erickson","party":"R","state":"WY","date":null,"withdrawn":false},{"name":"Harshman","party":"R","state":"WY","date":null,"withdrawn":false},{"name":"Lucas","party":"R","state":"WY","date":null,"withdrawn":false},{"name":"Singh","party":"R","state":"WY","date":null,"withdrawn":false},{"name":"Washut","party":"R","state":"WY","date":null,"withdrawn":false},{"name":"Wasserburger","party":"R","state":"WY","date":null,"withdrawn":false},{"name":"Barlow","party":"R","state":"WY","date":null,"withdrawn":false},{"name":"Jones","party":"R","state":"WY","date":null,"withdrawn":false},{"name":"Rothfuss","party":"D","state":"WY","date":null,"withdrawn":false}],"cosponsorCount":12,"committees":[],"actions":[{"date":"2026-03-06","text":"Assigned Chapter Number 60","chamber":"Governor"},{"date":"2026-03-06","text":"Governor Signed HEA No. 0019","chamber":null},{"date":"2026-03-03","text":"S President Signed HEA No. 0019","chamber":"Senate"},{"date":"2026-03-03","text":"H Speaker Signed HEA No. 0019","chamber":"House"},{"date":"2026-03-03","text":"Assigned Number HEA No. 0019","chamber":"Governor"},{"date":"2026-03-03","text":"H Concur:Passed 58-1-3-0-0","chamber":"House"},{"date":"2026-03-02","text":"H Received for Concurrence","chamber":"House"},{"date":"2026-03-02","text":"S 3rd Reading:Passed 30-1-0-0-0","chamber":"Senate"},{"date":"2026-02-27","text":"S 2nd Reading:Passed","chamber":"Senate"},{"date":"2026-02-26","text":"S COW:Passed","chamber":"Senate"},{"date":"2026-02-25","text":"S Placed on General File","chamber":"Senate"},{"date":"2026-02-25","text"