t: other","url":"https://legislature.mi.gov/Bills/Bill?ObjectName=2026-HB-6426","textUrl":"https://legislature.mi.gov/documents/2025-2026/billintroduced/House/htm/2026-HIB-6426.htm","versions":[{"label":"House Introduced Bill","date":null,"url":"https://legislature.mi.gov/documents/2025-2026/billintroduced/House/htm/2026-HIB-6426.htm","type":"HTML"}],"votes":[],"documents":[],"dataAsOf":"2026-11-01","aiSummary":"The bill would set new rules for local review of large-scale data centers, which are big facilities used for servers and data storage. It would require developers to give local governments detailed project information, post most of it for public review, and let local governments ask for more details and recover their review costs. It would also limit when people can challenge local decisions in court and allow fines for material misstatements. The act would take effect 90 days after it becomes law, but only if House Bill 6427 also becomes law.","aiSummaryBasis":"bill text","aiSummaryModel":"gpt-5.4-mini","aiSummaryGenerated":"2026-11-05","aiSummaryThin":false},"MI-2025-HB4011":{"id":"MI-2025-HB4011","passed":false,"number":"HB 4011","title":"Property: conveyance of state property; transfer of certain state-owned property in Arenac County; provide for. Creates land transfer act.","summary":null,"summarySource":null,"introduced":"2025-01-14","sponsor":{"name":"Mike Hoadley","party":"R","state":"MI","district":"99"},"cosponsors":[{"name":"Mike McFall","party":"D","state":"MI","date":null,"withdrawn":false},{"name":"John Roth","party":"R","state":"MI","date":null,"withdrawn":false},{"name":"Brian BeGole","party":"R","state":"MI","date":null,"withdrawn":false},{"name":"Tim Kelly","party":"R","state":"MI","date":null,"withdrawn":false},{"name":"Ken Borton","party":"R","state":"MI","date":null,"withdrawn":false},{"name":"Angela Rigas","party":"R","state":"MI","date":null,"withdrawn":false},{"name":"Jaime Greene","party":"R","state":"MI","date":null,"withdrawn":fals