{"jurisdiction":"MI","generatedAt":"2026-11-05T05:54:04Z","bills":{"MI-2025-HB6440":{"id":"MI-2025-HB6440","passed":false,"number":"HB 6440","title":"Marihuana: taxation; additional excise tax on wholesale marihuana; suspend for a period of time Amends sec. 5 of 2025 PA 23 (MCL 205.905).","summary":null,"summarySource":null,"introduced":"2026-10-28","sponsor":{"name":"Jay DeBoyer","party":"R","state":"MI","district":"63"},"cosponsors":[],"cosponsorCount":0,"committees":[],"actions":[{"date":"2026-11-05","text":"bill electronically reproduced 10/28/2026","chamber":"House"},{"date":"2026-10-28","text":"introduced by Representative Rep. Jay DeBoyer","chamber":"House"},{"date":"2026-10-28","text":"read a first time","chamber":"House"},{"date":"2026-10-28","text":"referred to Committee on Appropriations","chamber":"House"}],"law":null,"policyArea":"Marihuana: taxation","url":"https://legislature.mi.gov/Bills/Bill?ObjectName=2026-HB-6440","textUrl":"https://legislature.mi.gov/documents/2025-2026/billintroduced/House/htm/2026-HIB-6440.htm","versions":[{"label":"House Introduced Bill","date":null,"url":"https://legislature.mi.gov/documents/2025-2026/billintroduced/House/htm/2026-HIB-6440.htm","type":"HTML"}],"votes":[],"documents":[],"dataAsOf":"2026-11-01","aiSummary":"The bill would pause the extra tax on wholesale marihuana for one year after the law takes effect. It would affect marihuana businesses such as growers, retail licensees, and provisioning centers that sell or transfer marihuana. After that year, the tax would apply again at the rates already set in state law.","aiSummaryBasis":"bill text","aiSummaryModel":"gpt-5.4-mini","aiSummaryGenerated":"2026-11-05","aiSummaryThin":false},"MI-2025-HB6433":{"id":"MI-2025-HB6433","passed":false,"number":"HB 6433","title":"Property: recording; process for expedited quiet title; provide for. Amends sec. 2529 of 1961 PA 236 (MCL 600.2529) & adds secs. 2932a, 2932b, 2932c & 2932d.","summary":null,"summarySource":null,"introduc