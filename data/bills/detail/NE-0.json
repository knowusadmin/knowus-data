s":[],"cosponsorCount":0,"committees":[],"actions":[{"date":"2026-08-28","text":"Notice of hearing for October 28, 2026","chamber":"Legislature"},{"date":"2026-03-30","text":"Referred to Education Committee","chamber":"Legislature"},{"date":"2026-03-20","text":"Referred to Executive Board","chamber":"Legislature"},{"date":"2026-03-20","text":"Date of introduction","chamber":"Legislature"}],"law":null,"policyArea":null,"url":"https://nebraskalegislature.gov/bills/search_by_date.php?SessionDay=2026","textUrl":"https://nebraskalegislature.gov/FloorDocs/109/PDF/Intro/LR389.pdf","versions":[{"label":"Introduced","date":null,"url":"https://nebraskalegislature.gov/FloorDocs/109/PDF/Intro/LR389.pdf","type":"PDF"}],"votes":[],"documents":[],"dataAsOf":"2026-11-01","aiSummary":"This resolution would direct the Education Committee to study the school services and learning supports available to deaf and hard of hearing elementary students in Nebraska. The study would look at teacher training, communication supports like sign language interpretation and captioning, early language and reading results, family and school coordination, staff training, and service gaps in rural areas. The committee would also gather input from parents, educators, specialists, educational service units, and state agencies, then report its findings and recommendations to the Legislature.","aiSummaryBasis":"bill text","aiSummaryModel":"gpt-5.4-mini","aiSummaryGenerated":"2026-11-05","aiSummaryThin":false},"NE-2025-LR403":{"id":"NE-2025-LR403","passed":false,"number":"LR 403","title":"Interim study on the use of shackling on juveniles","summary":null,"summarySource":null,"introduced":"2026-03-24","sponsor":{"name":"Rountree","party":"Nonpartisan","state":"NE","district":"3"},"cosponsors":[],"cosponsorCount":0,"committees":[],"actions":[{"date":"2026-08-25","text":"Notice of hearing for September 21, 2026","chamber":"Legislature"},{"date":"2026-03-30","text":"Referred to Judiciary Committee","chamber":"Legislature"},{"date":"2026-03-24","text":"Referred to Executive Board","chamber":"Legislature"},{"date":"2026-03-24","text":"Date of introduction","chamber":"Legislature"}],"law":null,"policyArea":null,"url":"https://nebraskalegislature.gov/bills/search_by_date.php?SessionDay=2026","textUrl":"https://nebraskalegislature.gov/FloorDocs/109/PDF/Intro/LR403.pdf","versions":[{"label":"Introduced","date":null,"url":"https://nebraskalegislature.gov/FloorDocs/109/PDF/Intro/LR403.pdf","type":"PDF"}],"votes":[],"documents":[],"dataAsOf":"2026-11-01","aiSummary":"This resolution would direct the Judiciary Committee to study the use of shackling on juveniles. The study would look at when shackling should be barred or allowed, what new rules might be needed, and what other states have done. After the study, the committee would report its findings and recommendations to the Legislature or Legislative Council.","aiSummaryBasis":"bill text","aiSummaryModel":"gpt-5.4-mini","aiSummaryGenerated":"2026-11-05","aiSummaryThin":false},"NE-2025-LR382":{"id":"NE-2025-LR382","passed":false,"number":"LR 382","title":"Interim study to examine issues related to play therapy access in Nebraska","summary":null,"summarySource":null,"introduced":"2026-03-20","sponsor":{"name":"Fredrickson","party":"Nonpartisan","state":"NE","district":"20"},"cosponsors":[],"cosponsorCount":0,"committees":[],"actions":[{"date":"2026-07-21","text":"Notice of hearing for September 16, 2026","chamber":"Legislature"},{"date":"2026-03-30","text":"Referred to Health and Human Services Committee","chamber":"Legislature"},{"date":"2026-03-20","text":"Referred to Executive Board","chamber":"Legislature"},{"date":"2026-03-20","text":"Date of introduction","chamber":"Legislature"}],"law":null,"policyArea":null,"url":"https://nebraskalegislature.gov/bills/search_by_date.php?SessionDay=2026","textUrl":"https://nebraskalegislature.gov/FloorDocs/109/PDF/Intro/LR382.pdf","versions":[{"label":"Introduced","date":null,"url":"https://n