gov/Bills/Bill?ObjectName=2026-HB-6437","textUrl":"https://legislature.mi.gov/documents/2025-2026/billintroduced/House/htm/2026-HIB-6437.htm","versions":[{"label":"House Introduced Bill","date":null,"url":"https://legislature.mi.gov/documents/2025-2026/billintroduced/House/htm/2026-HIB-6437.htm","type":"HTML"}],"votes":[],"documents":[],"dataAsOf":"2026-11-01","aiSummary":"The bill would create a state tax credit program for sales or rentals of farm assets to new farmers. It would let the agriculture department certify beginning farmers and approve credits for owners who sell or rent land, livestock, buildings, or machinery to them. The credits would be capped at $32,000 for a sale, up to $7,000 a year for a cash rent deal, and up to $10,000 a year for a share-rent deal, with a $5 million yearly cap for the program. It would also require an annual report on the program starting June 1, 2028.","aiSummaryBasis":"bill text","aiSummaryModel":"gpt-5.4-mini","aiSummaryGenerated":"2026-11-05","aiSummaryThin":false},"MI-2025-SB980":{"id":"MI-2025-SB980","passed":false,"number":"SB 980","title":"Consumer protection: other; cryptocurrency kiosks; prohibit the installation and operation of. Creates new act.","summary":null,"summarySource":null,"introduced":"2026-05-19","sponsor":{"name":"Jeff Irwin","party":"D","state":"MI","district":"15"},"cosponsors":[{"name":"Sue Shink","party":"D","state":"MI","date":null,"withdrawn":false},{"name":"Dayna Polehanki","party":"D","state":"MI","date":null,"withdrawn":false},{"name":"Veronica Klinefelt","party":"D","state":"MI","date":null,"withdrawn":false},{"name":"Erika Geiss","party":"D","state":"MI","date":null,"withdrawn":false},{"name":"Stephanie Chang","party":"D","state":"MI","date":null,"withdrawn":false}],"cosponsorCount":5,"committees":[],"actions":[{"date":"2026-10-27","text":"REPORTED FAVORABLY WITHOUT AMENDMENT 10/14/2026","chamber":"Senate"},{"date":"2026-10-27","text":"REFERRED TO COMMITTEE OF THE WHOLE","chamber":"Senate"},{